{
  "name": "autoprint",
  "license": "MIT",
  "publisher": "ashwinnair10",
  "repository": {
    "type": "git",
    "url": "https://github.com/ashwinnair10/autoprint"
  },
  "displayName": "autoprint",
  "description": "Generate debug print statements automatically.",
  "version": "0.0.3",
  "engines": {
    "vscode": "^1.117.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "autoprint.generatePrint",
        "title": "Generate Print Statement"
      },
      {
        "command": "autoprint.removePrints",
        "title": "Remove AutoPrint Statements"
      }
    ],
    "keybindings": [
      {
        "command": "autoprint.generatePrint",
        "key": "ctrl+alt+z",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "autoprint.generatePrint",
          "group": "navigation"
        },
        {
          "command": "autoprint.removePrints",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.117.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
